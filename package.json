{
  "name": "tia-norma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "sim": "tsx scripts/sim.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:down": "tsx scripts/db-down.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  }
