# Supabase: Project Settings → Data API
SUPABASE_URL=

# Supabase: Project Settings → API Keys → Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=

# Supabase: Connect → Transaction pooler (puerto 6543). La usa la app.
DATABASE_URL=

# Supabase: Connect → Session pooler (puerto 5432). La usan las migraciones.
DATABASE_URL_MIGRATIONS=

# Meta for Developers → tu app → WhatsApp → Configuración de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Meta for Developers → tu app → Configuración de la app → Básica → Clave secreta
WHATSAPP_APP_SECRET=

# Lo inventás vos y lo pegás también en WhatsApp → Configuración → Webhook
WHATSAPP_VERIFY_TOKEN=

# Números que administran el taller, separados por coma, con código de país
AUTHORIZED_NUMBERS=

# Claude Console → API Keys. La usa el intérprete y `pnpm eval`.
ANTHROPIC_API_KEY=

# console.groq.com → API Keys. La usa el transcriptor y `pnpm eval:audio`.
GROQ_API_KEY=
